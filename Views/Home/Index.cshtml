@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center titulo">
    <h1 class="display-4"><strong>BANCO EL TUKI FC</strong></h1>
    <p><strong>El banco que te toca</strong></p>
</div>

<form asp-action="Resultado" method="post">

    <div class="form-group">
        <h2>Información Personal</h2>

        <div>
            <label>Nombre</label>
        </div>
        <div>
            <input type="text" name="nombre" />
        </div>

        <div>
            <label>Edad</label>
        </div>
        <div>
            <input type="number" name="edad" />
        </div>

        <div>
            <label>DNI</label>
        </div>
        <div>
            <input type="number" name="DNI" />
        </div>
    </div>

    <div class="form-group">
        <h2>Situación Laboral</h2>

        <div>
            <label>Trabaja</label>
        </div>

        <div class="opcion">
            <input type="radio" name="trabaja" value="si" id="trabaja_si">
            <label for="trabaja_si">Sí</label>
        </div>

        <div class="opcion">
            <input type="radio" name="trabaja" value="no" id="trabaja_no">
            <label for="trabaja_no">No</label>
        </div>

        <div>
            <label>Tipo de empleo</label>
        </div>

        <div>
            <select name="tipoEmpleo">
                <option>Relación de dependencia</option>
                <option>Monotributista</option>
                <option>Autónomo</option>
                <option>Desempleado</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <h2>Información económica</h2>

        <div>
            <label>Ingreso mensual</label>
        </div>

        <div>
            <input type="number" name="ingresoMensual" />
        </div>

        <div>
            <label>¿Tiene deudas?</label>
        </div>

        <div class="opcion">
            <input type="radio" name="deudas" value="si" id="deudas_si" />
            <label for="deudas_si">Sí</label>
        </div>

        <div class="opcion">
            <input type="radio" name="deudas" value="no" id="deudas_no" />
            <label for="deudas_no">No</label>
        </div>

        <div>
            <label>Tipo de deuda</label>
        </div>

        <div class="opcion">
            <input type="checkbox" name="tipoDeuda" value="Tarjeta de crédito" id="tarjeta" />
            <label for="tarjeta">Tarjeta de crédito</label>
        </div>

        <div class="opcion">
            <input type="checkbox" name="tipoDeuda" value="Préstamo bancario" id="prestamo_bancario" />
            <label for="prestamo_bancario">Préstamo bancario</label>
        </div>

        <div class="opcion">
            <input type="checkbox" name="tipoDeuda" value="Préstamo informal" id="prestamo_informal" />
            <label for="prestamo_informal">Préstamo informal</label>
        </div>
    </div>

    <div class="form-group">
        <h2>Información del préstamo</h2>

        <div>
            <label>Monto solicitado</label>
        </div>

        <div>
            <input type="number" name="montoSolicitado" />
        </div>

        <div>
            <label>Plazo</label>
        </div>

        <div>
            <select name="plazo">
                <option>6 meses</option>
                <option>12 meses</option>
                <option>24 meses</option>
            </select>
        </div>
    </div>

    <div class="opcion">
        <input type="checkbox" name="aceptarTerminos" value="true" id="terminos" />
        <label for="terminos">Aceptar términos y condiciones</label>
    </div>

    <div>
        <button type="submit">Enviar Datos</button>
    </div>
</form>